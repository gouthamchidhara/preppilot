# PrepPilot Deployment Credentials
# Copy to .env and fill in values. NEVER commit .env to git.

# ──────────────────────────────────────────────
# EXPO / EAS (iOS builds & TestFlight submission)
# ──────────────────────────────────────────────
# Option A: Access token from https://expo.dev/accounts/gchid/settings/access-tokens
#   (creates a token that works without interactive login)
EXPO_TOKEN=

# Option B: Username/password (used by `eas login` — don't store password here if using token)
# EAS_USERNAME=
# EAS_PASSWORD=

# Apple Developer credentials for EAS Submit (used when not logged in interactively)
# API Key method (preferred for CI):
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
APPLE_API_KEY_PATH=        # Path to AuthKey_XXXXXXXX.p8 file
APPLE_TEAM_ID=KSD8FCH7C9

# ──────────────────────────────────────────────
# AZURE (infrastructure & deployment)
# ──────────────────────────────────────────────
# Service principal for CI/CD (create with: az ad sp create-for-rbac --role contributor --scopes /subscriptions/<id>)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=c3514a59-2641-4ae2-91b1-30364f9631c6

# Azure resource names
AZURE_RESOURCE_GROUP=rg-preppilot
AZURE_SWA_NAME=swa-preppilot-cmncqy5swqngi

# ──────────────────────────────────────────────
# GOOGLE CLOUD (OAuth for sign-in)
# ──────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=372383686135-jj1mv49jbskilvqk6qfiqguh4uqjkdl5.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=372383686135-dvfs7h64g3vlnhkclilepbjtrnah55rd.apps.googleusercontent.com

# ──────────────────────────────────────────────
# REVENUECAT (in-app purchases)
# ──────────────────────────────────────────────
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=

# ──────────────────────────────────────────────
# GITHUB (CI/CD)
# ──────────────────────────────────────────────
# Fine-grained PAT with repo + workflow scope
GITHUB_TOKEN=
