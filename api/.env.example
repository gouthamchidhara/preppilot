# Copy to api/.env for local dev (git-ignored). Leave AZURE_* empty to run with mock AI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Optional: require this code in the app (Profile > Access code) during private beta
ACCESS_CODE=
RATE_CHAT_PER_HOUR=40
RATE_GENERATE_PER_HOUR=6
DAILY_AI_CAP=3000
